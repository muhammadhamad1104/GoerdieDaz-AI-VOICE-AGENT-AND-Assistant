# ─────────────────────────────────────────────
# GeordieDaz — Local Environment Variables
# Copy to .env and fill in your real values
# ─────────────────────────────────────────────

# Your OpenAI API Key (covers voice, embeddings, memory extraction)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
JINA_API_KEY=
LANGSMITH_API_KEY=
LLM_PROVIDER=openai

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Generate a strong password and use it in both POSTGRES_PASSWORD and DATABASE_URL.
# DATABASE_URL must use the postgresql+asyncpg driver and your configured database credentials.
POSTGRES_PASSWORD=
DATABASE_URL=
# Optional dedicated test database URL, never a production database.
TEST_DATABASE_URL=

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379/0

# CORS — add your local frontend URL
ALLOWED_ORIGINS=http://localhost:5173

# Memory tuning
MEMORY_IMPORTANCE_THRESHOLD=0.6
WORKING_MEMORY_SIZE=20
SESSION_TTL_HOURS=24

# Demo account credentials
DEMO_EMAIL=geordie@geordiedaz.com
DEMO_PASSWORD=
DEMO_USERNAME=geordie_demo

# Set to "development" for verbose SQL logs
ENVIRONMENT=development
LOG_LEVEL=INFO
